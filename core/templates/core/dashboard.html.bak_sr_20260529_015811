<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // =====================================================
    // DATA DARI DJANGO
    // =====================================================
    const labelsJenis = {{ labels_jenis|default:"[]"|safe }};
    const dataJenis = {{ data_jenis|default:"[]"|safe }};
    const labelsArea = {{ labels_area|default:"[]"|safe }};
    const dataArea = {{ data_area|default:"[]"|safe }};

    // Debug di browser console
    console.log("Total Pie =", dataJenis.reduce((a, b) => a + Number(b), 0));
    console.log("Total Bar =", dataArea.reduce((a, b) => a + Number(b), 0));
    console.log("Labels Pie =", labelsJenis.length);
    console.log("Labels Bar =", labelsArea.length);

    // =====================================================
    // PIE CHART (SEMUA DATA)
    // =====================================================
    new Chart(document.getElementById('flmChart'), {
        type: 'doughnut',
        data: {
            // PENTING: TIDAK ADA .slice(...)
            labels: labelsJenis,
            datasets: [{
                // PENTING: TIDAK ADA .slice(...)
                data: dataJenis.map(v => Number(v)),
                backgroundColor: [
                    '#0059A3',
                    '#FFD100',
                    '#00AEEF',
                    '#1D6F42',
                    '#FF8C00',
                    '#6c757d',
                    '#8e44ad',
                    '#e74c3c',
                    '#2ecc71',
                    '#f39c12',
                    '#16a085',
                    '#2980b9'
                ],
                borderWidth: 2,
                borderColor: '#ffffff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        boxWidth: 12,
                        padding: 15
                    }
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return context.label + ': ' + context.parsed.toLocaleString('id-ID');
                        }
                    }
                }
            }
        }
    });

    // =====================================================
    // BAR CHART (SEMUA DATA)
    // =====================================================
    new Chart(document.getElementById('areaChart'), {
        type: 'bar',
        data: {
            // PENTING: TIDAK ADA .slice(...)
            labels: labelsArea,
            datasets: [{
                label: 'Jumlah Pekerjaan (SR)',
                // PENTING: TIDAK ADA .slice(...)
                data: dataArea.map(v => Number(v)),
                backgroundColor: '#0059A3',
                borderRadius: 5
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return context.parsed.y.toLocaleString('id-ID');
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                },
                x: {
                    grid: {
                        display: false
                    }
                }
            }
        }
    });

    // =====================================================
    // TREND CHART
    // =====================================================
    const trendData = {{ trend_data|default:"{}"|safe }};

    if (trendData.labels && trendData.labels.length > 0) {
        new Chart(document.getElementById('trendChart'), {
            type: 'line',
            data: {
                labels: trendData.labels,
                datasets: trendData.datasets.map(ds => ({
                    ...ds,
                    borderWidth: 2,
                    fill: false,
                    pointBackgroundColor: '#0059A3',
                    pointBorderColor: '#fff',
                    pointRadius: 4,
                    pointHoverRadius: 6
                }))
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0,
                            stepSize: 1
                        }
                    }
                },
                plugins: {
                    legend: {
                        position: 'top'
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false
                    }
                }
            }
        });
    } else {
        document.getElementById('trendChart').parentNode.innerHTML =
            '<p class="text-muted text-center">Tidak ada data tren untuk ditampilkan.</p>';
    }

    // =====================================================
    // TOGGLE LEADERBOARD
    // =====================================================
    document.getElementById('toggleLeaderboard').addEventListener('click', function() {
        const container = document.getElementById('leaderboardContainer');
        const button = document.getElementById('toggleLeaderboard');

        if (container.classList.contains('d-none')) {
            container.classList.remove('d-none');
            button.textContent = 'Sembunyikan Leaderboard FLM';
        } else {
            container.classList.add('d-none');
            button.textContent = 'Tampilkan Leaderboard FLM';
        }
    });

    // =====================================================
    // TOGGLE PREDICTIVE TABLE
    // =====================================================
    document.getElementById('togglePredictive').addEventListener('click', function() {
        const container = document.getElementById('predictiveContainer');
        const button = document.getElementById('togglePredictive');

        if (container.classList.contains('d-none')) {
            container.classList.remove('d-none');
            button.textContent = 'Sembunyikan AI Assistance';
        } else {
            container.classList.add('d-none');
            button.textContent = 'AI Assistance';
        }
    });
</script>

<script>
    // =====================================================
    // AI RECOMMENDATION ENGINE
    // =====================================================
    function getAIRecommendation() {
        const cmId = document.getElementById('cmSelector').value;
        if (!cmId) {
            alert('Pilih CM terlebih dahulu!');
            return;
        }

        // Show loading
        document.getElementById('aiLoading').style.display = 'block';
        document.getElementById('aiResult').style.display = 'none';
        document.getElementById('aiError').style.display = 'none';

        fetch(`/api/ai-recommendation/${cmId}/`)
            .then(res => res.json())
            .then(data => {
                document.getElementById('aiLoading').style.display = 'none';

                if (data.status === 'error') {
                    document.getElementById('aiError').style.display = 'block';
                    document.getElementById('aiError').textContent = 'Error: ' + data.message;
                    return;
                }

                // Tampilkan query
                document.getElementById('aiQuery').textContent = data.query || '-';

                // Render similar cases — dark theme
                let simHtml = '';
                if (data.similar_cases && data.similar_cases.length > 0) {
                    data.similar_cases.forEach(c => {
                        const badgeClass = c.similarity >= 70 ? 'badge-high' : c.similarity >= 50 ? 'badge-med' : 'badge-low';
                        const statusClass = c.status === 'Finish' ? 'status-finish' : 'status-open';
                        const barColor = c.similarity >= 70 ? '#00c864' : c.similarity >= 50 ? '#ffc107' : 'rgba(255,255,255,0.3)';
                        simHtml += `<div class="case-card">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <span style="color:#00d4ff; font-weight:700; font-size:0.88rem;">CM-${c.cm_id}</span>
                                <span class="badge-sim ${badgeClass}">${c.similarity}%</span>
                            </div>
                            <div class="similarity-bar"><div class="similarity-fill" style="width:${c.similarity}%; background:${barColor};"></div></div>
                            <div style="color:rgba(255,255,255,0.4); font-size:0.75rem; margin:8px 0 4px;">${c.area || '-'} · ${c.nama_peralatan || '-'}</div>
                            <div style="color:rgba(255,255,255,0.7); font-size:0.82rem; line-height:1.4;">${c.deskripsi ? c.deskripsi.substring(0,100)+'...' : '-'}</div>
                            <span class="status-pill ${statusClass} mt-2 d-inline-block">${c.status}</span>
                        </div>`;
                    });
                } else {
                    simHtml = '<div style="color:rgba(255,255,255,0.3); text-align:center; padding:20px;">Tidak ada kasus serupa</div>';
                }
                document.getElementById('similarCases').innerHTML = simHtml;

                // Render relevant IKP — dark theme
                let ikpHtml = '';
                if (data.relevant_ikp && data.relevant_ikp.length > 0) {
                    data.relevant_ikp.forEach(ikp => {
                        const badgeClass = ikp.relevance >= 70 ? 'badge-high' : ikp.relevance >= 50 ? 'badge-med' : 'badge-low';
                        const barColor = ikp.relevance >= 70 ? '#00c864' : ikp.relevance >= 50 ? '#ffc107' : 'rgba(255,255,255,0.3)';
                        ikpHtml += `<div class="ikp-card">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <span style="color:#00ff88; font-weight:700; font-size:0.82rem; flex:1; padding-right:8px;">${ikp.title}</span>
                                <span class="badge-sim ${badgeClass}">${ikp.relevance}%</span>
                            </div>
                            <div class="similarity-bar"><div class="similarity-fill" style="width:${ikp.relevance}%; background:${barColor};"></div></div>
                            <span style="background:rgba(0,212,255,0.15); color:#00d4ff; font-size:0.68rem; padding:2px 8px; border-radius:10px; margin-top:8px; display:inline-block;">${ikp.category}</span>
                            <div style="color:rgba(255,255,255,0.55); font-size:0.8rem; line-height:1.5; margin-top:8px;">${ikp.chunk ? ikp.chunk.substring(0,130)+'...' : '-'}</div>
                        </div>`;
                    });
                } else {
                    ikpHtml = '<div style="color:rgba(255,255,255,0.3); text-align:center; padding:20px;">Tidak ada IKP relevan</div>';
                }
                document.getElementById('relevantIkp').innerHTML = ikpHtml;

                // Generated at
                document.getElementById('aiGeneratedAt').textContent =
                    'Generated: ' + (data.generated_at || '-');

                // Render LLM results (Kemungkinan Penyebab, Langkah, Keselamatan)
                const llmFields = [
                    ['llmPenyebab', data.kemungkinan_penyebab],
                    ['llmLangkah', data.langkah_penanganan],
                    ['llmKeselamatan', data.perhatian_keselamatan],
                ];
                
                let hasLLM = false;
                llmFields.forEach(([elemId, items]) => {
                    const el = document.getElementById(elemId);
                    if (el) {
                        if (items && items.length > 0) {
                            el.innerHTML = items.map(item => 
                                `<li class="ai-list-item">${item}</li>`
                            ).join('');
                            hasLLM = true;
                        } else {
                            el.innerHTML = '<li class="ai-list-item" style="opacity:0.4;">Tidak ada data</li>';
                        }
                    }
                });
                
                // Tampilkan section LLM
                const llmDiv = document.getElementById('llmResult');
                if (llmDiv) {
                    llmDiv.style.display = hasLLM ? 'block' : 'none';
                }
                
                // Model info
                const modelEl = document.getElementById('llmModel');
                if (modelEl && data.llm_model) {
                    modelEl.textContent = '🤖 Powered by: ' + data.llm_model;
                }

                // Show result
                document.getElementById('aiResult').style.display = 'block';
                
                // Scroll ke hasil
                document.getElementById('aiResult').scrollIntoView({behavior: 'smooth'});
            })
            .catch(err => {
                document.getElementById('aiLoading').style.display = 'none';
                document.getElementById('aiError').style.display = 'block';
                document.getElementById('aiError').textContent = 'Network error: ' + err;
            });
    }

    // Auto-load kalau ada CM yang dipilih dari URL param
    const urlParams = new URLSearchParams(window.location.search);
    const autoCmId = urlParams.get('cm_id');
    if (autoCmId) {
        const sel = document.getElementById('cmSelector');
        if (sel) {
            sel.value = autoCmId;
            getAIRecommendation();
        }
    }
</script>

