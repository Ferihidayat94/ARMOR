<div id="predictiveContainer" class="d-none">

    <!-- ===== AI RECOMMENDATION ENGINE ===== -->
    <div class="ai-section">
        <div class="ai-header">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <span class="ai-badge"><i class="ti ti-cpu" style="font-size:13px;"></i> AI Powered</span>
                        <span style="color:rgba(255,255,255,0.4); font-size:0.75rem;"><i class="ti ti-sparkles" style="font-size:12px;"></i> ARMOR</span>
                    </div>
                    <h3 class="fw-bold text-white mb-1" style="font-size:1.6rem; letter-spacing:-0.5px;">
                        <i class="ti ti-robot" aria-hidden="true"></i> AI Maintenance Assistant
                    </h3>
                    <p style="color:rgba(255,255,255,0.55); font-size:0.88rem; margin:0;">
                        Analisa gangguan Corrective Maintenance — kemungkinan penyebab, langkah penanganan, & IKP relevan
                    </p>
                </div>

            </div>
        </div>

        <div class="ai-body">
            <!-- INPUT -->
            <div class="row g-2 mb-4">
                <div class="col-md-9">
                    <select id="cmSelector" class="form-select ai-select w-100">
                        <option value="">⚡ Pilih CM Corrective untuk dianalisa...</option>
                        {% for cm in recent_cms %}
                        <option value="{{ cm.id }}">{{ cm.waktu_lapor|date:"d/m/Y" }} | CM-{{ cm.id }} | {{ cm.area|default:"-" }} | {{ cm.nama_peralatan|default:"(no equipment)" }} | {{ cm.deskripsi|default:""|truncatechars:50 }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <button class="btn ai-btn w-100" onclick="getAIRecommendation()">
                        <span id="btnText"><i class="ti ti-bolt" aria-hidden="true" style="font-size:16px;"></i> Analisa</span>
                    </button>
                </div>
            </div>

            <!-- LOADING -->
            <div id="aiLoading" style="display:none;">
                <div class="ai-loading-custom">
                    <div class="ai-spinner"></div>
                    <p style="color:rgba(255,255,255,0.5); font-size:0.9rem;">AI sedang menganalisa gangguan...</p>
                    <p style="color:rgba(255,255,255,0.3); font-size:0.78rem;">Mencari kasus serupa & IKP relevan</p>
                </div>
            </div>

            <!-- HASIL -->
            <div id="aiResult" style="display:none;">
                <!-- Query box -->
                <div class="ai-query-box">
                    <div style="color:rgba(255,255,255,0.4); font-size:0.72rem; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;">Menganalisa:</div>
                    <div class="text-white fw-semibold" id="aiQuery" style="font-size:0.9rem;"></div>
                </div>

                <!-- LLM Result: 3 cards -->
                <div id="llmResult" style="display:none;">
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="ai-result-card ai-card-cause h-100">
                                <div class="ai-card-header">
                                    <i class="ti ti-alert-triangle" aria-hidden="true"></i> Kemungkinan Penyebab
                                </div>
                                <div class="ai-card-body">
                                    <ol class="ps-3 mb-0" id="llmPenyebab"></ol>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="ai-result-card ai-card-steps h-100">
                                <div class="ai-card-header">
                                    <i class="ti ti-tool" aria-hidden="true"></i> Langkah Penanganan
                                </div>
                                <div class="ai-card-body">
                                    <ol class="ps-3 mb-0" id="llmLangkah"></ol>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="ai-result-card ai-card-safety h-100">
                                <div class="ai-card-header">
                                    <i class="ti ti-shield-check" aria-hidden="true"></i> Perhatian Keselamatan
                                </div>
                                <div class="ai-card-body">
                                    <ol class="ps-3 mb-0" id="llmKeselamatan"></ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="ai-divider">

                <!-- Similar Cases + IKP -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <div style="color:rgba(255,255,255,0.5); font-size:0.75rem; text-transform:uppercase; letter-spacing:1px; margin-bottom:12px;"><i class="ti ti-history" aria-hidden="true"></i> Kasus Serupa di Historis</div>
                        <div id="similarCases"></div>
                    </div>
                    <div class="col-md-6">
                        <div style="color:rgba(255,255,255,0.5); font-size:0.75rem; text-transform:uppercase; letter-spacing:1px; margin-bottom:12px;"><i class="ti ti-book-2" aria-hidden="true"></i> Instruksi Kerja Relevan</div>
                        <div id="relevantIkp"></div>
                    </div>
                </div>

                <div class="ai-powered">
                    <div class="ai-pulse"></div>
                    <span id="aiGeneratedAt"></span>
                    &nbsp;·&nbsp;
                    <span id="llmModel"></span>
                </div>
            </div>

            <!-- ERROR -->
            <div id="aiError" style="display:none;" class="alert mt-3" style="background:rgba(220,53,69,0.15); border:1px solid rgba(220,53,69,0.3); color:#ff6b7a; border-radius:12px;"></div>
        </div>
    </div>

    <!-- ===== KNOWLEDGE MAINTENANCE CENTER ===== -->
    <div class="knowledge-section">
        <div class="kms-header">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <span style="background:linear-gradient(135deg,#FFD100,#f0a500); color:#004075; font-size:0.7rem; font-weight:700; padding:4px 12px; border-radius:20px; letter-spacing:1px; text-transform:uppercase;"><i class="ti ti-database" style="font-size:12px;"></i> Knowledge Base</span>
                        
                    </div>
                    <h3 class="fw-bold text-white mb-1" style="font-size:1.5rem; letter-spacing:-0.3px;">
                        <i class="ti ti-database" aria-hidden="true"></i> Knowledge Maintenance Center
                    </h3>
                    <p style="color:rgba(255,255,255,0.5); font-size:0.85rem; margin:0;">
                        Pusat pencarian SOP, Manual, History Gangguan & Instruksi Kerja Pemeliharaan
                    </p>
                </div>

            </div>
        </div>
        <div class="kms-body">
            <!-- SEARCH -->
            <form method="GET" action="{% url 'knowledge_search' %}">
                <div class="input-group mb-4" style="box-shadow: 0 4px 20px rgba(255,209,0,0.1);">
                    <input type="text" name="q" class="form-control kms-search" 
                           placeholder="Cari SOP, manual, history kerusakan, instruksi kerja..." required>
                    <button class="btn kms-search-btn" type="submit">
                        <i class="ti ti-search" aria-hidden="true"></i> Cari
                    </button>
                </div>
            </form>
            <!-- CATEGORIES -->
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="kms-cat-card kms-cat-sop">
                        <div class="kms-cat-icon"><i class="ti ti-file-check" aria-hidden="true"></i></div>
                        <div class="kms-cat-title">SOP</div>
                        <div class="kms-cat-desc">Standard Operating Procedure</div>
                        <div class="kms-count-sop">{{ sop_count }}</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="kms-cat-card kms-cat-manual">
                        <div class="kms-cat-icon"><i class="ti ti-settings-2" aria-hidden="true"></i></div>
                        <div class="kms-cat-title">Manual</div>
                        <div class="kms-cat-desc">Manual peralatan & maintenance</div>
                        <div class="kms-count-manual">{{ manual_count }}</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="kms-cat-card kms-cat-history">
                        <div class="kms-cat-icon"><i class="ti ti-archive" aria-hidden="true"></i></div>
                        <div class="kms-cat-title">History</div>
                        <div class="kms-cat-desc">History gangguan & pekerjaan</div>
                        <div class="kms-count-history">{{ history_count }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

        <div class="mt-5 pt-4 text-center border-top">
            <p class="text-muted small mt-2">© 2026 Armor v2.0 - Bidang Pemeliharaan & Operasi</p>
        </div>
    </div>

