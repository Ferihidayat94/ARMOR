        textColor=colors.HexColor('#2C3E50'),
        fontName='Helvetica-Bold'
    ))

    elements = []

    for item in data_list:

        # =========================
        # KOP SURAT
        # =========================
        _add_kop_surat(elements, styles)

        # =========================
        # JUDUL
        # =========================
        title_text = (
            f"<b>LAPORAN RTPM</b> "
            f"&nbsp;&nbsp; Periode: {bulan_nama} {tahun}"
        )

        elements.append(
            Paragraph(title_text, styles['RTPMTitle'])
        )

        elements.append(Spacer(1, 12))

        # =========================
        # PELAKSANA
        # =========================
        pelaksana = item.get('pelaksana', '-')

        if not pelaksana or pelaksana == '-':
            nama_ttd = '__________________________'
        else:
            nama_ttd = pelaksana

        # =========================
        # DATA DETAIL
        # =========================
        data_pairs = [
            ["Equipment", str(item.get('equipment', '-'))],
            ["Deskripsi", str(item.get('deskripsi', '-'))],
            ["Area", str(item.get('area', '-'))],
            ["Tanggal", str(item.get('tanggal', '-'))],
            ["Minggu Ke", str(item.get('minggu_ke', '-'))],
            ["Status", str(item.get('status', '-'))],
            ["Pelaksana", str(pelaksana)],
            ["Catatan", Paragraph(
                str(item.get('catatan', '')).replace('\n', '<br/>'),
                styles['Normal']
            )],
        ]

        _add_vertical_detail_table(
            elements,
            styles,
            data_pairs
        )

        # =========================
        # FOTO EVIDENCE
        # =========================
        evidence = item.get('evidence')
        if evidence:
            try:
                from reportlab.platypus import Image
                from reportlab.lib.units import inch
                buf = _optimize_image_from_url(evidence)
                if buf:
                    elements.append(Spacer(1, 10))
                    elements.append(Paragraph("<b>Evidence</b>", styles['Normal']))
                    elements.append(Spacer(1, 5))
                    img = Image(buf, width=3.5 * inch, height=2.5 * inch)
                    elements.append(img)
                    elements.append(Spacer(1, 10))
            except Exception as e:
                logger.error(f"ERROR FOTO RTPM: {e}")

        # =========================
        # TANDA TANGAN
        # =========================
        _add_signature_block(
            elements,
            styles,
            nama_ttd
        )

        elements.append(PageBreak())

    # hapus page kosong terakhir
    if elements and isinstance(elements[-1], PageBreak):
        elements.pop()

    doc.build(elements)

    pdf_buffer.seek(0)

    return pdf_buffer.getvalue()



