        'First Line Maintenance ( A )': 'A',
        'First Line Maintenance ( B )': 'B',
        'First Line Maintenance ( C )': 'C',
        'First Line Maintenance ( D )': 'D',
    }
    # Counting leaderboard dari M2M eksekutor_list (semua personel dapat kredit)
    # Fallback ke eksekutor (single) kalau M2M kosong
    for item in queryset:
        jenis = item.jenis_pekerjaan or ''
