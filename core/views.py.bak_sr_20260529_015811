@login_required
def rtpm_export_pdf(request):

    bulan = request.GET.get('bulan')
    tahun = request.GET.get('tahun')

    data = RTPM.objects.all().order_by('-tanggal')

    if bulan:
        data = data.filter(tanggal__month=bulan)

    if tahun:
        data = data.filter(tanggal__year=tahun)

    data_list = []

    for item in data:

        data_list.append({
            'equipment': item.equipment,
            'deskripsi': item.deskripsi,
            'area': item.area,
            'tanggal': item.tanggal.strftime('%d-%m-%Y') if item.tanggal else '-',
            'minggu_ke': item.minggu_ke,
            'status': item.status,
            'pelaksana': item.pelaksana,
            'catatan': item.catatan,

            # FOTO: helper akan handle path lokal & URL Supabase
            'evidence': item.evidence.name if item.evidence else None,
        })

    bulan_nama = ''

    if bulan:
        bulan_nama = calendar.month_name[int(bulan)]

    pdf_file = create_rtpm_pdf_report(
        data_list,
        bulan_nama,
        tahun
    )

    response = HttpResponse(
        pdf_file,
        content_type='application/pdf'
    )

    response['Content-Disposition'] = (
        f'attachment; filename="RTPM_{bulan_nama}_{tahun}.pdf"'
    )

    return response

def ai_recommendation_detail(request, cm_id):
    from django.http import JsonResponse
    from core.models import AIRecommendation
    if not request.user.is_authenticated:
        return JsonResponse({'status': 'error', 'message': 'Login required'}, status=401)
    try:
        rec = AIRecommendation.objects.get(pekerjaan_id=cm_id)
        # Auto-invalidate kalau data LLM kosong (cache lama)
        if not rec.langkah_penanganan:
            rec.delete()
            raise AIRecommendation.DoesNotExist
        return JsonResponse({
            'status': 'ready',
            'cm_id': cm_id,
            'query': rec.query_text[:200],
            'similar_cases': rec.similar_cases,
            'relevant_ikp': rec.relevant_ikp,
            'kemungkinan_penyebab': rec.kemungkinan_penyebab,
            'langkah_penanganan': rec.langkah_penanganan,
            'perhatian_keselamatan': rec.perhatian_keselamatan,
            'llm_model': rec.llm_model,
            'generated_at': rec.generated_at.strftime('%d-%m-%Y %H:%M'),
        })
    except AIRecommendation.DoesNotExist:
        try:
            from core.ai.search_engine import get_ai_recommendation
            result = get_ai_recommendation(cm_id)
            if result:
                rec, _ = AIRecommendation.objects.update_or_create(
                    pekerjaan_id=cm_id,
                    defaults={
                        'query_text': result.get('query', ''),
                        'similar_cases': result.get('similar_cases', []),
                        'relevant_ikp': result.get('relevant_ikp', []),
                        'kemungkinan_penyebab': result.get('kemungkinan_penyebab', []),
                        'langkah_penanganan': result.get('langkah_penanganan', []),
                        'perhatian_keselamatan': result.get('perhatian_keselamatan', []),
                        'llm_model': result.get('llm_model', ''),
                        'is_ready': True,
                    }
                )
                return JsonResponse({
                    'status': 'ready',
                    'cm_id': cm_id,
                    'query': rec.query_text[:200],
                    'similar_cases': rec.similar_cases,
                    'relevant_ikp': rec.relevant_ikp,
                    'kemungkinan_penyebab': result.get('kemungkinan_penyebab', []),
                    'langkah_penanganan': result.get('langkah_penanganan', []),
                    'perhatian_keselamatan': result.get('perhatian_keselamatan', []),
                    'llm_model': result.get('llm_model', ''),
                    'generated_at': rec.generated_at.strftime('%d-%m-%Y %H:%M'),
                })
            else:
                return JsonResponse({'status': 'error', 'message': 'Tidak ada data cukup'})
        except Exception as e:
            return JsonResponse({'status': 'error', 'message': str(e)})
    except Exception as e:
        return JsonResponse({'status': 'error', 'message': str(e)})
