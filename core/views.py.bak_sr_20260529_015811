    for row in queryset.values('jenis_pekerjaan').annotate(total=Count('id')):
        jenis_full = row['jenis_pekerjaan'] or 'Tidak Diketahui'
        label = JENIS_MAP.get(jenis_full, {}).get('label', jenis_full)
