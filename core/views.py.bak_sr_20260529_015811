                              key=lambda x: x[1], reverse=True)[:10]
        leaderboard[regu_key] = [{'nama': n, 'jumlah': j} for n, j in sorted_items]

    trend_queryset = (
        queryset.exclude(waktu_lapor__isnull=True)
        .annotate(bulan=TruncMonth('waktu_lapor'))
        .values('bulan', 'jenis_pekerjaan')
        .annotate(total=Count('id'))
        .order_by('bulan')
    )
    bulan_set = set()
    jenis_set = set()
    for row in trend_queryset:
        if row['bulan']:
            bulan_set.add(row['bulan'])
