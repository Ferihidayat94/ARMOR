            # Populate M2M: semua personel yang match dari nama_pelaksana
            if 'matched_personels' in dir() and matched_personels:
                pekerjaan.eksekutor_list.set(matched_personels)

            # Notifikasi Telegram untuk Corrective Maintenance
            if "Corrective" in jenis:
                foto_url = ""
                if pekerjaan.foto_evidence:
                    try:
                        foto_url = request.build_absolute_uri(pekerjaan.foto_evidence.url)
                    except Exception:
                        foto_url = ""
                ticket_id = f"CM-{pekerjaan.id}"
                send_telegram_notification(
                    ticket_id, area, keterangan, nama_pelaksana,
                    nomor_sr, foto_url, nama_peralatan
                )
                # AI Recommendation Engine + Telegram notification
                try:
                    import threading
                    def run_ai_rec(cm_id, t_id, t_area, t_alat, t_desc):
                        try:
                            send_telegram_ai_recommendation(
                                cm_id=cm_id,
                                ticket_id=t_id,
                                area=t_area,
                                nama_peralatan=t_alat,
                                deskripsi=t_desc,
                            )
                        except Exception as e:
                            import logging
                            logging.getLogger(__name__).error(f"AI rec error CM-{cm_id}: {e}")
                    
                    cm_thread = threading.Thread(
                        target=run_ai_rec,
                        args=(
                            pekerjaan.id,
                            ticket_id,
                            area,
                            nama_peralatan,
                            keterangan,
                        ),
                        daemon=True
                    )
                    cm_thread.start()
                except Exception as e:
