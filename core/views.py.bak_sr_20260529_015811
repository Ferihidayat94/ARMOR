def check_overdue_rtpm():
    url = os.getenv("SUPABASE_URL")
    key = os.getenv("SUPABASE_KEY")
    supabase = create_client(url, key)
    today = date.today().isoformat()
    try:
        resp = supabase.table("rtpm_jadwal") \
            .select("id") \
            .lt("tanggal", today) \
            .eq("status", "Pending") \
            .execute()
        for item in resp.data:
            supabase.table("rtpm_jadwal").update({"status": "Overdue"}).eq("id", item["id"]).execute()
    except Exception as e:
        logger.error(f"Gagal update overdue RTPM: {e}")


