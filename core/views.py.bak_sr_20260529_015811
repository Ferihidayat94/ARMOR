def input_pekerjaan(request):
    from core.models import Pekerjaan, Personel
    from datetime import datetime

    if request.method == "POST":
        tanggal = request.POST.get('tanggal', '')
        jenis = request.POST.get('jenis', '')
        
        # Validasi: user hanya boleh input jenis sesuai regu nya
        user_regu_check = get_user_regu(request.user)
        if user_regu_check:  # Kalau bukan superuser
            allowed_flm = f'First Line Maintenance ( {user_regu_check} )'
            if 'First Line Maintenance' in jenis and jenis != allowed_flm:
                messages.error(request, f"Anda hanya boleh input {allowed_flm} atau Corrective Maintenance.")
                return redirect('input_pekerjaan')
            if 'Preventive' in jenis:
                messages.error(request, "Preventive Maintenance hanya bisa di-input oleh Admin.")
                return redirect('input_pekerjaan')
        area = request.POST.get('area', '')
        nama_peralatan = request.POST.get('nama_peralatan', '')
        nomor_sr = request.POST.get('nomor_sr', '')
        nama_pelaksana = request.POST.get('nama_pelaksana', '')
        status = request.POST.get('status', 'Open')
        keterangan = request.POST.get('keterangan', '')

        # Smart matching: parsing nama pelaksana (boleh multiple: "ABI, KEVIN, NOVA")
        # Ambil personel pertama yang match untuk dijadikan eksekutor utama
        import re as _re
        eksekutor = None
        if nama_pelaksana:
            personel_map = {p.nama.upper(): p for p in Personel.objects.all()}
            ALIASES = {
                'IWAN': 'IRWAN', 'ABI': 'ABI WAHYUDI', 'ABY': 'ABI WAHYUDI',
                'KEVIN': 'KEVIN ANANDA NURDIANSA', 'YOGA': 'YOGA EKA PUTRA',
                'IRFAN': 'IRFAN SUSANTO', 'SHIFA': 'SHIFA NUR HARYO', 'SIFA': 'SHIFA NUR HARYO',
                'IVAN': 'IVAN LESMANA', 'JASRIL': 'JASRIL RIZA',
                'NOVA': 'NOVA FEBRIAN', 'YOGI': 'YOGI PRATAMA',
                'GANDA': 'GANDA PUTRA SETIAWAN', 'CHANDRA': 'ICANDRA',
                'ZAMZAMI': 'ACHMAD ZAMZAMI', 'ZAMI': 'ACHMAD ZAMZAMI',
                'AMIN': 'MUHAMMAD AMIN', 'HABIBI': 'MUTTAQIN HABIBI',
                'VIRGI': 'VIRGIAWAN ERTANTO', 'ODI': 'ODIDIO PRATAMA',
                'WILLI': 'WILLY RISWENGKY', 'WILLY': 'WILLY RISWENGKY',
                'RIAN': 'M ADHZERIAN S R', 'RIYAN': 'M ADHZERIAN S R',
                'ROVEL': 'ROVEL POLVO', 'DENIS': 'DENI SYAFUTRA', 'DENI': 'DENI SYAFUTRA',
                'ZAINUL': 'M ZAINUL ABDI', 'EDWIN': 'EDWIN JASTIN',
                'FIDDIN': 'FIDDIN KISWANTO', 'FIDIN': 'FIDDIN KISWANTO',
                'AKHMAD': 'AKHMAD WISNU WARDANA', 'WISNU': 'AKHMAD WISNU WARDANA',
                'TRI': 'TRI SUHENDRI', 'IMAM': 'M IMAM SAPUTRO',
                'RIOS': 'REYVALDO RIOS', 'RICO': 'RICO FERNANDO', 'RIKO': 'RICO FERNANDO',
                'INNAYA': 'INNAYA GALVANO', 'ANDRI': 'ANDRI WIDIAN',
                'NANANG': 'NANANG OKTAVIAN HIDAYAT', 'LEO': 'LEO MALDINI',
                'ZULGHOFAH': 'M ZULGHOFAH', 'DECKY': 'DECKY PRADANA',
                'INDRA': 'INDRA ERYANSYAH', 'KAMALUDIN': 'IMAM KAMALUDIN',
                'IRFANI': 'MUHAMAD IRFANI', 'TEGUH': 'TEGUH KARYA',
                'LEDIE': 'LEDIE AGUSSETIAWAN', 'ABDI': 'ABDI SAPUTRA OCTAMAL',
                'SEPTIAN': 'RICO TRI SEPTIAN', 'BERRY': 'BERRY GUSTIAWAN',
                'YOPAN': 'YOPAN SANDRA WILLY', 'RIDUWAN': 'MUHAMMAD RIDUWAN',
                'SUNIR': 'SUNIR', 'RENO': 'RENO FARLOVES',
                'EKA': 'EKA CANDRA', 'CANDRA': 'EKA CANDRA',
                'AMINUDIN': 'AMINUDDIN', 'HENDRA': 'MUHAMMAD HENDRA',
                'MIDUN': 'SARMIDUN', 'RAFI': 'RAFFY FERDINAN', 'RAFFY': 'RAFFY FERDINAN',
                'DIKA': 'DIKA ARIA BARMA', 'DEBBI': 'DEBIGUSTRARANDA',
                'GILANG': 'GILANG EN TAMAL', 'SOLEH': 'MUHAMMAD SOLEH ALQODRI',
                'DIKI': 'DIKY APRIYANTO', 'AKBAR': 'AKBAR RULLA',
            }
            # Kumpulkan SEMUA personel yang match dari tokens
            matched_personels = []
            tokens = _re.split(r',|\bDAN\b|\bdan\b|/|&|\+', nama_pelaksana)
            for token in tokens:
                token = token.strip().upper()
                token = _re.sub(r'\([^)]*\)', '', token).strip()
                if not token:
                    continue
                matched = None
                if token in personel_map:
                    matched = personel_map[token]
                elif token in ALIASES:
                    key = ALIASES[token].upper()
                    if key in personel_map:
                        matched = personel_map[key]
                else:
                    for nama_upper, p in personel_map.items():
                        if nama_upper.split()[0] == token:
                            matched = p
                            break
                if matched and matched not in matched_personels:
                    matched_personels.append(matched)
            # Eksekutor utama = personel pertama yang match
            if matched_personels:
                eksekutor = matched_personels[0]

        # Parse tanggal
        try:
            if tanggal:
                waktu_lapor = datetime.strptime(tanggal, '%Y-%m-%d')
                waktu_lapor = timezone.make_aware(waktu_lapor)
            else:
                waktu_lapor = timezone.now()
        except Exception:
            waktu_lapor = timezone.now()

        try:
            # Simpan ke database VPS via Django ORM
            pekerjaan = Pekerjaan.objects.create(
                judul_pekerjaan=nama_peralatan or '-',
                jenis_pekerjaan=jenis,
                area=area,
                deskripsi=keterangan or '-',
                status=status,
                waktu_lapor=waktu_lapor,
                eksekutor=eksekutor,
                nama_peralatan=nama_peralatan,
                nomor_sr=nomor_sr,
                nama_pelaksana=nama_pelaksana,
                created_by=request.user if request.user.is_authenticated else None,
                foto_evidence=request.FILES.get('evidance'),
                foto_evidence_after=request.FILES.get('evidance_after'),
